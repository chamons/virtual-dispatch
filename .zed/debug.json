// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Build & Debug native binary",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
  },
  {
    "adapter": "CodeLLDB",
    "label": "cargo test -p virtual-dispatch --all-targets",
    "build": {
      "label": "cargo test -p virtual-dispatch --all-targets",
      "command": "cargo",
      "args": [
        "test",
        "--package",
        "virtual-dispatch",
        "--all-targets",
        "--no-run",
      ],
      "env": {
        "RUSTC_TOOLCHAIN": "/Users/donblas/.rustup/toolchains/stable-aarch64-apple-darwin",
      },
      "cwd": "/Users/donblas/Programming/virtual-dispatch",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "tags": [],
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "sourceLanguages": ["rust"],
  },
]
